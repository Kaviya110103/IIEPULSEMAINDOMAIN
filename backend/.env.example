# Backend environment variables
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret
DJANGO_DEBUG=False
DEPLOYMENT_DOMAIN=127.0.0.1:8000
DEPLOYMENT_SCHEME=http
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173
APP_PORTAL_URL=http://localhost:5173

# Use either DATABASE_URL or the DB_* values below.
DATABASE_URL=
DB_NAME=iiepulse
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSL=False
DB_CONN_MAX_AGE=600

DJANGO_MEDIA_ROOT=

BREVO_API_KEY=replace-with-brevo-api-key
DEFAULT_FROM_EMAIL=your-email@example.com
DEFAULT_FROM_NAME=IIE Pulse
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

MSG91_WIDGET_ID=replace-with-msg91-widget-id
MSG91_AUTH_TOKEN=replace-with-msg91-auth-token

DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
