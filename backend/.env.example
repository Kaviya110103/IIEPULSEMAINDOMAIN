# Backend environment variables
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret
DJANGO_DEBUG=False
DEPLOYMENT_DOMAIN=iiepulse.indrainstitute.com
DEPLOYMENT_SCHEME=https
DJANGO_ALLOWED_HOSTS=iiepulse.indrainstitute.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://iiepulse.indrainstitute.com
CORS_ALLOWED_ORIGINS=https://iiepulse.indrainstitute.com
APP_PORTAL_URL=https://iiepulse.indrainstitute.com

# Use either DATABASE_URL or the DB_* values below.
DATABASE_URL=
DB_NAME=iiepulse
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSL=False
DB_CONN_MAX_AGE=600

DJANGO_MEDIA_ROOT=

BREVO_API_KEY=replace-with-brevo-api-key
DEFAULT_FROM_EMAIL=your-email@example.com
DEFAULT_FROM_NAME=IIE Pulse

MSG91_WIDGET_ID=replace-with-msg91-widget-id
MSG91_AUTH_TOKEN=replace-with-msg91-auth-token

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
